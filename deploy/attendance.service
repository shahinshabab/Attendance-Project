[Unit]
Description=Office fingerprint attendance API
After=network.target

[Service]
Type=simple
User=attendance
Group=attendance
WorkingDirectory=/opt/attendance/current
Environment=DATABASE_PATH=/var/lib/attendance/attendance.sqlite3
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/attendance/venv/bin/python -m uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/attendance
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
